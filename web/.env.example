# URL base de tu proyecto Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto-aqui.supabase.co

# Llave pública anónima (anon public key)
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase-aqui
